---
import type { RegionTerms } from "@/lib/region";
import Leader from "@/components/ui/Leader.astro";
import TornEdge from "@/components/ui/TornEdge.astro";
import { type Currency, withCode } from "@/lib/currency";
import { rentCalculation, savingGoals } from "@/lib/landing-data";

interface Props {
  currency: Currency;
  region: RegionTerms;
}

const { currency, region } = Astro.props;
const eachPayday = withCode(2500, currency);
---

<section id="big" aria-labelledby="big-title" class="wrap big">
  <div class="copy">
    <span class="eyebrow">SAVING FOR</span>
    <h2 id="big-title" class="display-2">
      {region.rent.many} stop being a <span class="marker">surprise.</span>
    </h2>
    <p class="body">
      Tell Trove what's coming and when. It works out how much to set aside each payday, so the big
      ones are already there on the day.
    </p>
    <ul class="goals">
      {
        savingGoals(region).map((goal) => (
          <li class="goal">
            <span class="goal-head">
              <span aria-hidden="true" class="goal-emoji">
                {goal.emoji}
              </span>
              <span class="goal-name">{goal.name}</span>
              <span class:list={["goal-note", { warn: goal.warn }]}>{goal.note}</span>
            </span>
            <span aria-hidden="true" class="track">
              <span class="fill" style={`width:${goal.pct}%`} />
            </span>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="slip-col">
    <div class="slip" role="group" aria-label={`${region.rent.one} 2 of 4: ${eachPayday} to set aside each payday`}>
      <div class="paper">
        <div class="slip-title">🏠 {region.rent.one.toUpperCase()} 2 OF 4</div>
        <div class="slip-meta">DUE TUE 1 DEC · REPEATS EVERY 3 MONTHS</div>
        <div class="rule"></div>
        {
          rentCalculation(currency, region).map((row) => (
            <div class="row">
              <span>{row.label}</span>
              <Leader />
              <span class="row-value">{row.value}</span>
            </div>
          ))
        }
        <div class="rule"></div>
        <div class="total"><span>EACH PAYDAY</span><span class="hl">{eachPayday}</span></div>
        <div class="slip-meta">*** THEN IT STARTS AGAIN FOR MARCH ***</div>
      </div>
      <TornEdge span={440} width="100%" fill="var(--dark-surface-paper)" />
    </div>
  </div>
</section>

<style>
  .big {
    padding-top: var(--section-pad);
    padding-bottom: var(--section-pad);
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
    align-items: center;
  }

  .copy {
    flex: 1 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .body {
    margin: 0;
    max-width: 500px;
    font-size: 19px;
    line-height: 1.55;
    color: var(--dark-text-secondary);
  }

  .goals {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 520px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .goal {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .goal-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .goal-emoji {
    font-size: 20px;
  }

  .goal-name {
    flex: 1;
    font-size: 18px;
    font-weight: 800;
  }

  .goal-note {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--dark-text-secondary);
  }

  .goal-note.warn {
    color: var(--dark-warning-text);
  }

  .track {
    display: block;
    height: 8px;
    border-radius: 999px;
    background: var(--dark-border-subtle);
  }

  .fill {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: var(--dark-highlight);
  }

  .slip-col {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    justify-content: center;
  }

  .slip {
    width: 100%;
    max-width: 440px;
    display: flex;
    flex-direction: column;
    transform: rotate(2deg);
  }

  .paper {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px 28px 22px;
    background: var(--dark-surface-paper);
    color: var(--light-text-on-paper);
    font-family: var(--font-mono);
    font-size: 16px;
    line-height: 22px;
  }

  .slip-title {
    text-align: center;
    font-weight: 600;
    letter-spacing: 2px;
  }

  .slip-meta {
    text-align: center;
    font-size: 12px;
    color: var(--light-text-tertiary);
    letter-spacing: 1px;
  }

  .rule {
    border-top: 1.5px dashed var(--light-border-default);
  }

  .row {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .row-value {
    font-weight: 500;
  }

  .total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 19px;
    font-weight: 600;
  }

  .hl {
    padding: 0 6px;
    background: var(--dark-highlight);
  }
</style>
