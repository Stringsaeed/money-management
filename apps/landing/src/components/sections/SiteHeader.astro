---
import Logo from "@/components/ui/Logo.astro";

const links = [
  { href: "/#how", label: "How it works" },
  { href: "/#features", label: "Features" },
  { href: "/#big", label: "Big payments" },
  { href: "/#household", label: "Household" },
  { href: "/#promise", label: "Our promise" },
];
---

<header class="site-header">
  <a href="/" aria-label="Trove home" class="brand">
    <Logo />
    <span class="wordmark">trove</span>
  </a>
  <nav aria-label="Main" class="nav">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
  <a href="/#soon" class="cta">Coming soon</a>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 2;
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 22px var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--dark-text-primary);
    text-decoration: none;
  }

  .wordmark {
    font-size: 28px;
    line-height: 32px;
    font-weight: 900;
    letter-spacing: -1px;
  }

  .nav {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 26px;
    font-size: 16px;
    font-weight: 700;
  }

  .nav a {
    color: var(--dark-text-secondary);
    text-decoration: none;
    transition: color 120ms cubic-bezier(0.2, 0, 0, 1);
  }

  .nav a:hover {
    color: var(--dark-text-primary);
  }

  /* Phones: logo and CTA share the top row; the links become one swipeable row beneath. */
  @media (max-width: 760px) {
    .nav {
      order: 3;
      flex: 1 1 100%;
      flex-wrap: nowrap;
      gap: 22px;
      overflow-x: auto;
      scrollbar-width: none;
      white-space: nowrap;
    }

    .nav::-webkit-scrollbar {
      display: none;
    }

    .brand {
      flex: 1;
    }
  }

  .cta {
    height: 46px;
    padding: 0 22px;
    border-radius: 999px;
    background: var(--dark-highlight);
    color: var(--dark-bg-canvas);
    font-size: 16px;
    font-weight: 800;
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .cta:hover {
    background: var(--dark-accent-pressed);
    color: var(--dark-bg-canvas);
  }
</style>
