---
import { marketQuotes } from "@/lib/features-data";

const move = (change: number) => `${change > 0 ? "▲" : "▼"} ${Math.abs(change).toFixed(1)}%`;
---

<div class="market">
  <div class="head"><span>WATCHING</span><span>USD · LIVE</span></div>
  {
    marketQuotes.map((quote) => (
      <div class="quote">
        <span class="ticker">{quote.ticker}</span>
        <span class="what">
          <span class="name">{quote.name}</span>
          <span class="group">{quote.group}</span>
        </span>
        <span class:list={["move", quote.change > 0 ? "up" : "down"]}>{move(quote.change)}</span>
      </div>
    ))
  }
</div>

<style>
  .market {
    display: flex;
    flex-direction: column;
  }

  .head {
    display: flex;
    justify-content: space-between;
    margin-bottom: 4px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.2px;
    color: var(--dark-text-tertiary);
  }

  .quote {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    border-bottom: 1px solid var(--dark-border-subtle);
  }

  .quote:last-child {
    border-bottom: 0;
  }

  .ticker {
    width: 52px;
    height: 32px;
    flex: none;
    border-radius: 999px;
    background: var(--tile-ink);
    box-shadow: inset 0 0 0 1px var(--dark-border-default);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .what {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .name {
    font-size: 15px;
    line-height: 20px;
    font-weight: 700;
  }

  .group {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 1.2px;
    color: var(--dark-text-tertiary);
  }

  .move {
    padding: 3px 8px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
  }

  .up {
    background: var(--dark-positive-subtle);
    color: var(--dark-positive-text);
  }

  .down {
    background: var(--dark-negative-subtle);
    color: var(--dark-negative-text);
  }
</style>
