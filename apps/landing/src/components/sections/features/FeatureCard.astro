---
interface Props {
  eyebrow: string;
  title: string;
  detail: string;
  /** Ink cards break up the paper grid, as the ritual cards do. */
  tone?: "paper" | "ink";
  wide?: boolean;
}

const { eyebrow, title, detail, tone = "paper", wide = false } = Astro.props;
---

<li class:list={["card", tone, { wide }]}>
  <div class="visual" aria-hidden="true" inert><slot /></div>
  <div class="text">
    <span class="eyebrow-sm">{eyebrow}</span>
    <h3 class="title">{title}</h3>
    <p class="detail">{detail}</p>
  </div>
</li>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 12px 12px 26px;
    border-radius: 24px;
    background: var(--card-bg);
    color: var(--card-fg);
    box-shadow: inset 0 0 0 1px var(--card-ring);
  }

  .paper {
    --card-bg: var(--light-surface-default);
    --card-fg: var(--light-text-primary);
    --card-ring: var(--light-border-subtle);
    --card-well: var(--light-bg-canvas);
    --card-muted: var(--light-text-secondary);
    --card-faint: var(--light-text-tertiary);
  }

  .ink {
    --card-bg: var(--dark-bg-canvas);
    --card-fg: var(--dark-text-primary);
    --card-ring: var(--dark-border-subtle);
    --card-well: var(--dark-surface-default);
    --card-muted: var(--dark-text-secondary);
    --card-faint: var(--dark-text-tertiary);
  }

  @media (min-width: 720px) {
    .wide {
      grid-column: span 2;
    }
  }

  .visual {
    flex: 1;
    min-height: 196px;
    padding: 18px;
    border-radius: 16px;
    background: var(--card-well);
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0 12px;
  }

  .eyebrow-sm {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.4px;
    color: var(--card-faint);
  }

  .title {
    margin: 0;
    font-size: 26px;
    line-height: 30px;
    font-weight: 900;
    letter-spacing: -0.5px;
  }

  .detail {
    margin: 0;
    max-width: 520px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--card-muted);
  }
</style>
