---
import { type Currency, formatAmount } from "@/lib/currency";
import { type EntryKind, ledgerEntries, ledgerFilters } from "@/lib/features-data";

interface Props {
  currency: Currency;
}

const { currency } = Astro.props;
// Income carries a plus; transfers between your own accounts carry no sign at all.
const printed = (amount: number, kind: EntryKind) =>
  kind === "income" ? `+${formatAmount(amount, currency, true)}` : formatAmount(amount, currency, true);
---

<div class="ledger">
  <div class="search">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"
      ><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="M15.5 15.5 20 20"></path></svg
    >Search notes
  </div>
  <div class="filters">
    {ledgerFilters.map((filter) => <span class:list={["chip", { on: filter.on }]}>{filter.label}</span>)}
  </div>
  <div class="rows">
    {
      ledgerEntries.map((entry) => (
        <div class="row">
          <span class="tile">{entry.emoji}</span>
          <span class="what">
            <span class="name">{entry.name}</span>
            <span class="meta">{entry.meta}</span>
          </span>
          <span class:list={["amount", entry.kind]}>{printed(entry.amount, entry.kind)}</span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .ledger {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .search {
    height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    background: var(--light-surface-raised);
    box-shadow: inset 0 0 0 1px var(--light-border-subtle);
    color: var(--light-text-tertiary);
    font-size: 15px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .chip {
    height: 32px;
    padding: 0 12px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--light-border-default);
    font-size: 13px;
    font-weight: 700;
    display: flex;
    align-items: center;
  }

  .chip.on {
    background: var(--light-accent-fill);
    color: var(--light-accent-on);
    box-shadow: none;
  }

  .rows {
    display: flex;
    flex-direction: column;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 54px;
    border-bottom: 1px solid var(--light-border-subtle);
  }

  .row:last-child {
    border-bottom: 0;
  }

  .tile {
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 999px;
    background: var(--light-fill-neutral);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
  }

  .what {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .name {
    font-size: 15px;
    line-height: 20px;
    font-weight: 700;
  }

  .meta {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 15px;
    letter-spacing: 0.6px;
    color: var(--light-text-tertiary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .amount {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
  }

  .income {
    color: var(--light-positive-text);
  }

  .transfer {
    color: var(--light-text-secondary);
  }
</style>
