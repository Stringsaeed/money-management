---
import type { RegionTerms } from "@/lib/region";
import { type Currency, formatAmount } from "@/lib/currency";
import { recurringRules } from "@/lib/features-data";

interface Props {
  currency: Currency;
  region: RegionTerms;
}

const { currency, region } = Astro.props;
const printed = (amount: number) =>
  amount > 0 ? `+${formatAmount(amount, currency, true)}` : formatAmount(amount, currency, true);
---

<div class="rules">
  {
    recurringRules(region).map((rule) => (
      <div class="rule">
        <span class="date">
          <span class:list={["band", { next: rule.next }]}>{rule.mon}</span>
          <span class="day">{rule.day}</span>
        </span>
        <span class="what">
          <span class="name">
            {rule.emoji} {rule.name}
          </span>
          <span class="meta">{rule.rule}</span>
        </span>
        <span class:list={["amount", { income: rule.amount > 0 }]}>{printed(rule.amount)}</span>
      </div>
    ))
  }
</div>

<style>
  .rules {
    display: flex;
    flex-direction: column;
  }

  .rule {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 62px;
    border-bottom: 1px solid var(--light-border-subtle);
  }

  .rule:last-child {
    border-bottom: 0;
  }

  .date {
    width: 44px;
    flex: none;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: inset 0 0 0 1px var(--light-border-default);
    background: var(--light-surface-default);
    text-align: center;
    font-family: var(--font-mono);
    display: flex;
    flex-direction: column;
  }

  .band {
    padding: 2px 0;
    background: var(--light-fill-neutral);
    color: var(--light-text-secondary);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
  }

  .band.next {
    background: var(--light-highlight);
    color: var(--light-text-primary);
  }

  .day {
    padding: 2px 0 3px;
    font-size: 18px;
    line-height: 22px;
    font-weight: 500;
  }

  .what {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .name {
    font-size: 15px;
    line-height: 20px;
    font-weight: 700;
  }

  .meta {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
    color: var(--light-text-tertiary);
  }

  .amount {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
  }

  .income {
    color: var(--light-positive-text);
  }
</style>
