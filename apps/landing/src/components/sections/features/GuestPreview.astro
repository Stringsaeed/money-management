---
import Leader from "@/components/ui/Leader.astro";
import TornEdge from "@/components/ui/TornEdge.astro";
---

<div class="guest">
  <span class="option primary">Continue as guest</span>
  <span class="option">Sign in</span>
  <div class="slip">
    <div class="paper">
      <div class="line"><span>GUEST LEDGER</span><Leader /><span>KEPT</span></div>
      <span class="stamp">SAVED TO ACCOUNT</span>
    </div>
    <TornEdge span={240} width="100%" tooth={10} depth={8} fill="var(--light-surface-raised)" />
  </div>
</div>

<style>
  .guest {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .option {
    height: 44px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1.5px var(--light-border-default);
    font-size: 15px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .primary {
    background: var(--light-accent-fill);
    color: var(--light-accent-on);
    box-shadow: none;
  }

  .slip {
    margin-top: 8px;
    display: flex;
    flex-direction: column;
  }

  .paper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 14px 16px 10px;
    background: var(--light-surface-raised);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--light-text-on-paper);
  }

  .line {
    align-self: stretch;
    display: flex;
    gap: 6px;
  }

  .stamp {
    padding: 2px 8px;
    border: 1.5px solid var(--light-positive-text);
    border-radius: 6px;
    transform: rotate(-4deg);
    color: var(--light-positive-text);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.4px;
  }
</style>
