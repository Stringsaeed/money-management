---
import type { RegionTerms } from "@/lib/region";
import Leader from "@/components/ui/Leader.astro";

interface Props {
  region: RegionTerms;
}

const { region } = Astro.props;
---

<div class="smart">
  <div class="note">
    <span class="label">NOTE</span>
    <span class="typed">{region.groceryNote}<span class="caret"></span></span>
  </div>
  <svg class="arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
    ><path d="M12 5v14M6 13l6 6 6-6"></path></svg
  >
  <div class="pick">
    <span class="category">🛒 Groceries</span>
    <span class="tag">AI PICK</span>
  </div>
  <div class="slip">
    <div class="line"><span>SENT</span><Leader /><span>NOTE · CATEGORIES</span></div>
    <div class="line"><span>NEVER</span><Leader /><span>AMOUNTS · YOU</span></div>
  </div>
</div>

<style>
  .smart {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .note {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 16px;
    border-radius: 16px;
    background: var(--light-surface-raised);
    box-shadow: inset 0 0 0 1px var(--light-border-subtle);
  }

  .label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.2px;
    color: var(--light-text-tertiary);
  }

  .typed {
    display: flex;
    align-items: center;
    gap: 2px;
    font-size: 17px;
    font-weight: 700;
  }

  .caret {
    width: 2px;
    height: 20px;
    background: var(--light-text-primary);
  }

  .arrow {
    color: var(--light-text-tertiary);
  }

  .pick {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 6px 0 14px;
    border-radius: 999px;
    background: var(--light-accent-fill);
    color: var(--light-accent-on);
    font-size: 15px;
    font-weight: 800;
  }

  .category {
    color: var(--dark-text-primary);
  }

  .tag {
    padding: 4px 8px;
    border-radius: 999px;
    background: var(--light-highlight);
    color: var(--light-text-primary);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.2px;
  }

  .slip {
    align-self: stretch;
    margin-top: 6px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 18px;
    letter-spacing: 0.6px;
    color: var(--light-text-secondary);
  }

  .line {
    display: flex;
    gap: 6px;
  }
</style>
