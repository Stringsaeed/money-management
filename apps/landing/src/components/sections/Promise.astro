---
import TornEdge from "@/components/ui/TornEdge.astro";
import { nevers } from "@/lib/landing-data";
---

<section id="promise" aria-labelledby="promise-title" class="wrap promise">
  <div class="copy">
    <span class="eyebrow">OUR PROMISE</span>
    <h2 id="promise-title" class="display-2">What Trove will never do.</h2>
  </div>
  <div class="slip">
    <ul class="paper">
      {
        nevers.map((never) => (
          <li class="never">
            <span class="text">
              <span class="never-title">{never.title}</span>
              <span class="never-detail">{never.detail}</span>
            </span>
            <span class="void" aria-hidden="true">
              VOID
            </span>
          </li>
        ))
      }
    </ul>
    <TornEdge span={560} width="100%" fill="var(--dark-surface-paper)" />
  </div>
</section>

<style>
  .promise {
    padding-bottom: var(--section-pad);
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
    align-items: flex-start;
  }

  .copy {
    flex: 1 1 380px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .slip {
    flex: 1 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .paper {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    padding: 12px 28px 18px;
    list-style: none;
    background: var(--dark-surface-paper);
    color: var(--light-text-on-paper);
    font-family: var(--font-mono);
  }

  .never {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1.5px dashed var(--light-border-default);
  }

  .text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .never-title {
    font-family: var(--font-ui);
    font-size: 21px;
    line-height: 26px;
    font-weight: 900;
    text-decoration: line-through;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--light-negative-text);
  }

  .never-detail {
    font-family: var(--font-ui);
    font-size: 15px;
    line-height: 21px;
    color: var(--light-text-secondary);
  }

  .void {
    flex: none;
    padding: 2px 8px;
    border: 2px solid var(--light-negative-text);
    border-radius: 6px;
    transform: rotate(-6deg);
    color: var(--light-negative-text);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1.5px;
  }
</style>
