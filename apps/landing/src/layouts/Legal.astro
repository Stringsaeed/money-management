---
/**
 * Long-form legal page (privacy policy, terms): the document is printed on a paper slip,
 * like every other receipt on the site. Content comes from a Markdown page in `src/pages`.
 */
import SiteFooter from "@/components/sections/SiteFooter.astro";
import SiteHeader from "@/components/sections/SiteHeader.astro";
import TornEdge from "@/components/ui/TornEdge.astro";
import Base from "@/layouts/Base.astro";
import { legal } from "@/lib/site";

interface Props {
  frontmatter: {
    title: string;
    description: string;
    eyebrow: string;
    /** ISO date the current version takes effect. */
    effective: string;
  };
}

const { title, description, eyebrow, effective } = Astro.props.frontmatter;
const effectiveLabel = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
}).format(new Date(effective));
---

<Base title={`${title} — Trove`} {description}>
  <div class="page">
    <SiteHeader />
    <main class="wrap legal">
      <header class="head">
        <span class="eyebrow">{eyebrow}</span>
        <h1 class="display-2">{title}</h1>
        <p class="meta">
          Effective <time datetime={effective}>{effectiveLabel}</time> · Questions:
          <a href={`mailto:${legal.contactEmail}`}>{legal.contactEmail}</a>
        </p>
      </header>
      <article class="slip">
        <div class="paper"><slot /></div>
        <TornEdge span={760} width="100%" fill="var(--dark-surface-paper)" />
      </article>
    </main>
    <SiteFooter />
  </div>
</Base>

<style>
  .page {
    min-width: 320px;
    overflow: hidden;
  }

  .legal {
    padding-top: clamp(40px, 6vw, 88px);
    padding-bottom: var(--section-pad);
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 820px;
  }

  .meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.6px;
    color: var(--dark-text-tertiary);
  }

  .meta a {
    color: var(--dark-text-secondary);
  }

  .meta a:hover {
    color: var(--dark-text-primary);
  }

  .slip {
    max-width: 820px;
    display: flex;
    flex-direction: column;
  }

  .paper {
    padding: clamp(28px, 5vw, 56px) clamp(22px, 5vw, 64px) clamp(28px, 4vw, 48px);
    background: var(--dark-surface-paper);
    color: var(--light-text-on-paper);
    font-size: 17px;
    line-height: 1.65;
  }

  .paper > :global(:first-child) {
    margin-top: 0;
  }

  .paper :global(h2) {
    margin: 44px 0 12px;
    padding-top: 28px;
    border-top: 1.5px dashed var(--light-border-default);
    font-size: 24px;
    line-height: 30px;
    font-weight: 900;
    letter-spacing: -0.4px;
  }

  .paper :global(h3) {
    margin: 28px 0 8px;
    font-size: 18px;
    line-height: 24px;
    font-weight: 800;
  }

  .paper :global(p),
  .paper :global(ul) {
    margin: 0 0 14px;
  }

  .paper :global(ul) {
    padding-left: 22px;
  }

  .paper :global(li) {
    margin-bottom: 6px;
  }

  .paper :global(strong) {
    font-weight: 800;
  }

  .paper :global(a) {
    color: var(--light-accent-text);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }

  .paper :global(a:hover) {
    color: var(--light-text-primary);
  }

  .paper :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
  }

  .paper :global(.lede) {
    font-size: 19px;
    color: var(--light-text-secondary);
  }
</style>
