{
  // Static site + a small router Worker (geo currency). `pnpm build` first, then deploy.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "trove-landing",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Only the home page needs the Worker; everything else is served straight from assets.
    "run_worker_first": ["/", "/index.html", "/c/*"],
  },
}
