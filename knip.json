{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["app/**/*.tsx"],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "constants/**/*.{ts,tsx}",
    "db/**/*.{ts,tsx,js}",
    "hooks/**/*.{ts,tsx}",
    "stores/**/*.{ts,tsx}",
    "types/**/*.{ts,tsx}",
    "utils/**/*.{ts,tsx}",
    "scripts/**/*.{js,ts}",
    "lib/**/*.{ts,tsx}",
    "**/*.css"
  ],
  "ignoreDependencies": [
    "tailwind-variants",
    "tailwindcss-animate",
    "eas-build-cache-provider",
    "react-test-renderer",
    "@types/react-test-renderer",
    "@tanstack/query-core"
  ],
  "expo": {
    "config": ["app.config.ts"],
    "entry": ["app/**/*.{ts,tsx}"]
  }
}
