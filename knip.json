{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["app/**/*.tsx"],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "constants/**/*.{ts,tsx}",
    "db/**/*.{ts,tsx,js}",
    "hooks/**/*.{ts,tsx}",
    "stores/**/*.{ts,tsx}",
    "types/**/*.{ts,tsx}",
    "utils/**/*.{ts,tsx}",
    "scripts/**/*.{js,ts}"
  ],
  "ignoreDependencies": [
    "expo-linear-gradient",
    "babel-plugin-inline-import",
    "expo-updates",
    "tailwind-variants",
    "tailwindcss-animate",
    "@react-navigation/native-stack"
  ],
  "ignore": ["hooks/use-color-scheme.web.ts"],
  "expo": {
    "config": ["app.config.ts"],
    "entry": ["app/**/*.{ts,tsx}"]
  }
}
