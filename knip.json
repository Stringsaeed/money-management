{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["app/**/*.tsx"],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "constants/**/*.{ts,tsx}",
    "db/**/*.{ts,tsx,js}",
    "hooks/**/*.{ts,tsx}",
    "stores/**/*.{ts,tsx}",
    "types/**/*.{ts,tsx}",
    "utils/**/*.{ts,tsx}",
    "scripts/**/*.{js,ts}"
  ],
  "ignoreDependencies": [
    "expo-linear-gradient",
    "babel-plugin-inline-import",
    "tailwind-variants",
    "tailwindcss-animate",
    "eas-build-cache-provider",
    "victory-native"
  ],
  "ignore": [
    "components/ui/*.{ts,tsx}",
    "components/settings/category-spending-chart.tsx",
    "components/settings/stats-charts.tsx",
    "components/settings/transaction-trend-chart.tsx",
    "hooks/use-chart-data.ts",
    "jest/**/*.{ts,tsx,js}",
    "__tests__/**/*.{ts,tsx,js}"
  ],
  "expo": {
    "config": ["app.config.ts"],
    "entry": ["app/**/*.{ts,tsx}"]
  }
}
