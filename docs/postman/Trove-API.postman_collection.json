      "name": "Auth",
      "item": [
        {
          "name": "Sign up (email + password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const setCookie = pm.response.headers.get('Set-Cookie');",
                  "if (setCookie) {",
                  "  const match = setCookie.match(/better-auth\\.session_token=([^;]+)/);",
                  "  if (match) {",
                  "    const cookie = `better-auth.session_token=${match[1]}`;",
                  "    pm.environment.set('session_cookie', cookie);",
                  "    pm.collectionVariables.set('session_cookie', cookie);",
                  "  }",
                  "}",
                  "pm.test('Sign up succeeded', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{display_name}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{auth_url}}/sign-up/email"
          }
        },
