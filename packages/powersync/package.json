{
  "name": "@trove/powersync",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "live:verify": "node ../../node_modules/@powersync/node/download_core.js && node live-verify.mjs",
    "load:verify": "node ../../node_modules/@powersync/node/download_core.js && node ../../artifacts/powersync-planetscale/load.mjs",
    "test": "node --test __tests__/sync-streams.test.ts",
    "validate": "pnpm dlx powersync@0.10.0 validate --directory . --sync-config-file-path sync-streams.yaml --validate-only sync-config",
    "deploy": "pnpm dlx powersync@0.10.0 deploy sync-config --directory . --sync-config-file-path sync-streams.yaml"
  },
  "devDependencies": {
    "@powersync/common": "2.2.0",
    "@powersync/node": "1.0.0",
    "better-sqlite3": "12.11.1",
    "jose": "6.2.9",
    "postgres": "3.4.9",
    "yaml": "^2.9.0"
  }
}
