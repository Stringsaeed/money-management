    "postinstall": "pnpm build"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@trove/typescript-config": "workspace:*",
    "@types/node": "^24.10.9",
    "drizzle-kit": "^0.31.4",
    "typescript": "~7.0.2"
  }
}
