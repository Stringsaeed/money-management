{
  "name": "@trove/domain",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    "./calendar": {
      "types": "./dist/calendar.d.ts",
      "default": "./dist/calendar.js"
    },
    "./assignment-waterfall": {
      "types": "./dist/assignment-waterfall.d.ts",
      "default": "./dist/assignment-waterfall.js"
    },
    "./card-waterfall": {
      "types": "./dist/card-waterfall.d.ts",
      "default": "./dist/card-waterfall.js"
    },
    "./clock": {
      "types": "./dist/clock.d.ts",
      "default": "./dist/clock.js"
    },
    "./settlement": {
      "types": "./dist/settlement.d.ts",
      "default": "./dist/settlement.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "check-types": "tsc --project tsconfig.json --noEmit",
    "postinstall": "pnpm build"
  },
  "dependencies": {
    "@trove/protocol": "workspace:*",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@trove/typescript-config": "workspace:*",
    "typescript": "~7.0.2"
  }
}
