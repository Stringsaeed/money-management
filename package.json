{
  "name": "money-management",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "domain:build": "pnpm --filter @trove/domain build",
    "start": "pnpm domain:build && pnpm -C apps/mobile start",
    "reset-project": "pnpm -C apps/mobile reset-project",
    "android": "pnpm domain:build && pnpm -C apps/mobile android",
    "ios": "pnpm domain:build && pnpm -C apps/mobile ios",
    "web": "pnpm domain:build && pnpm -C apps/mobile web",
    "prebuild": "pnpm domain:build && pnpm -C apps/mobile prebuild",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check-loose-end": "pnpm domain:build && pnpm -C apps/mobile check-loose-end",
    "test": "pnpm domain:build && pnpm -C apps/mobile test",
    "test:watch": "pnpm domain:build && pnpm -C apps/mobile test:watch",
    "test:coverage": "pnpm domain:build && pnpm -C apps/mobile test:coverage",
    "test:ci": "pnpm domain:build && pnpm -C apps/mobile test:ci",
    "ts:check": "pnpm domain:build && pnpm -C apps/mobile ts:check",
    "push:storage": "node apps/mobile/scripts/push-code-storage.mjs",
    "api:dev": "pnpm --filter @trove/api dev",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:test": "supabase test db",
    "supabase:db:reset": "supabase db reset"
  },
  "devDependencies": {
    "@rnx-kit/oxlint-config": "^1.0.3",
    "@swmansion/argent": "^0.20.0",
    "eslint": "^10.8.1",
    "eslint-plugin-expo": "^1.1.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
